        "jsCode": "const rows=Array.isArray($json.data)?$json.data:[];const stable=new Set(['USDT','USDC','DAI','FDUSD','TUSD','USDP','EURT']);const banned=/(3L|3S|5L|5S|UP|DOWN|BULL|BEAR)$/i;let list=rows.filter(t=>{const id=String(t.instId||'');if(!id.endsWith('-USDT'))return false;const base=id.split('-')[0];if(stable.has(base)||banned.test(base))return false;return Number(t.volCcy24h||0)>0&&Number(t.last||0)>0;});list.sort((a,b)=>Number(b.volCcy24h||0)-Number(a.volCcy24h||0));return list.slice(0,20).map(t=>({json:{instId:t.instId,last:Number(t.last),volCcy24h:Number(t.volCcy24h||0)}}));"
