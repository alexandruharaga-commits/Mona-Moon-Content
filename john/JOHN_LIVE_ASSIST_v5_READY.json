    {
      "parameters": {
        "jsCode": "const s=$getWorkflowStaticData('global');const now=Date.now();s.mode='LIVE_ASSIST_SAFE';s.lastScanAt=new Date().toISOString();if(s.pendingTrade?.status==='pending'&&now<Number(s.pendingTrade.expiresAt||0))return [{json:{proposalCreated:false,reason:'PENDING_EXISTS'}}];if(s.pendingTrade?.status==='pending')s.pendingTrade.status='expired';const inputs=$input.all();const meta=$('JOHN Top 20 Liquid').all();const candidates=[];function m(raw){const c=raw.slice().reverse().map(x=>Number(x[4])).filter(x=>Number.isFinite(x)&&x>0);if(c.length<20)return null;const sma=n=>c.slice(-n).reduce((a,b)=>a+b,0)/n;const f=sma(5),slow=sma(20),last=c.at(-1),prev=c.at(-2);let g=0,l=0;for(let i=Math.max(1,c.length-14);i<c.length;i++){const d=c[i]-c[i-1];if(d>0)g+=d;else l-=d;}const rs=l===0?100:(g/14)/(l/14);const rsi=100-(100/(1+rs));return {f,slow,last,rsi,mom:(last-prev)/prev};}for(let i=0;i<inputs.length;i++){const instId=meta[i]?.json?.instId,raw=inputs[i]?.json?.data;if(!instId||!Array.isArray(raw))continue;const x=m(raw);if(x&&x.f>x.slow*1.001&&x.mom>0.001&&x.rsi>=52&&x.rsi<=68){const conf=Math.min(.95,.66+(x.f/x.slow-1)*25+x.mom*18);candidates.push({instId,m:x,confidence:Number(conf.toFixed(2))});}}if(!candidates.length){s.lastMarket={at:s.lastScanAt,marketOk:true,universe:meta.length};return [{json:{proposalCreated:false,reason:'NO_SIGNAL',scanned:meta.length}}];}candidates.sort((a,b)=>b.confidence-a.confidence);const c=candidates[0],amount=c.confidence>=.80?10:5;const p={id:'J'+now+'B',side:'buy',pair:c.instId,amountQuote:amount,entry:c.m.last,stopLoss:Number((c.m.last*.985).toFixed(8)),takeProfit:Number((c.m.last*1.03).toFixed(8)),confidence:c.confidence,reason:'Bullish 15m · RSI '+c.m.rsi.toFixed(1)+' · momentum '+(c.m.mom*100).toFixed(2)+'%',createdAt:now,expiresAt:now+20*60*1000,status:'pending'};s.pendingTrade=p;s.lastMarket={at:s.lastScanAt,marketOk:true,universe:meta.length,pair:c.instId,last:c.m.last,rsi:c.m.rsi};return [{json:{proposalCreated:true,proposal:p}}];"
      },
