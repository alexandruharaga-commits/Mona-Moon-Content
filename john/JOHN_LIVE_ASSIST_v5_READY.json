      "parameters": {
        "jsCode": "const s=$getWorkflowStaticData('global');\nconst b=$json.body||$json;\nconst p=s.pendingTrade;\nconst id=String(b.proposalId||'');\nconst dec=String(b.decision||'').toLowerCase();\nconst no=(message,ok=false)=>[{json:{ok,approved:false,message}}];\nif(!p||p.id!==id)return no('Proposal mismatch');\nif(p.status!=='pending')return no('Proposal '+p.status);\nif(Date.now()>=Number(p.expiresAt||0)){p.status='expired';return no('Proposal expired');}\nif(dec==='reject'){p.status='rejected';return [{json:{ok:true,approved:false,status:'rejected'}}];}\nif(dec!=='approve')return no('Decision must be approve or reject');\nconst amt=Number(p.amountQuote);\nif(![5,10].includes(amt))return no('Risk guard blocked amount');\np.status='approved_for_handoff';\np.confirmedAt=Date.now();\nconst pair=String(p.pair||'BTC-USDT').toLowerCase();\nreturn [{json:{ok:true,approved:true,status:'approved_for_manual_submit',pair:p.pair,side:p.side,amountQuote:p.amountQuote,entry:p.entry,stopLoss:p.stopLoss,takeProfit:p.takeProfit,openUrl:'https://www.okx.com/trade-spot/'+pair,message:'Aprobat. Verifică ordinul și apasă manual Submit în OKX.'}}];"
